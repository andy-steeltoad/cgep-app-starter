                    "statement-id": "SR-03.13.01.c",
                    "uuid": "321464b0-f4e0-4d9f-8bcf-ff740b5f891c",
                    "description": "AWS services are reached only through managed interfaces: aws_vpc_endpoint.s3 and aws_vpc_endpoint.dynamodb, each with an endpoint policy scoped to this workload's resources."
                  }
