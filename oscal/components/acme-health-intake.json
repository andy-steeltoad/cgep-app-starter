      "parties": [
        {
          "uuid": "3392b8be-0b4e-4be4-a78a-bbc17bbe9d79",
          "type": "organization",
          "name": "Acme Health GRC Engineering",
          "links": [
            {
              "rel": "website",
              "href": "https://github.com/andy-steeltoad/cgep-app-starter"
            }
          ]
        }
      ],
      "remarks": "Primary framework chosen is CMMC Level 2, which maps to NIST SP 800-171 Rev. 2. However, NIST publishes 800-171 only as a Rev. 3 OSCAL catalog, so control-ids reference the Rev. 3 catalog and each implemented-requirement carries the CMMC practice ID (cmmc-practice-id) and the Rev. 2 requirement number as properties. HIPAA Security Rule and SOC 2 TSC appear only as secondary cross-reference props."
    },
    "components": [
      {
        "uuid": "9472fb96-64c7-47f2-944f-6df77ce95592",
        "type": "service",
        "title": "Acme Health Patient Intake API",
        "description": "The cgep-app-starter Patient Intake API (API Gateway HTTP API -> Lambda -> DynamoDB + S3, in us-east-1), wrapped in a Terraform GRC baseline: a customer-managed KMS key, hardening overrides on the starter's S3 bucket, DynamoDB table and Lambda, a multi-region CloudTrail trail, and an Object Lock evidence vault. The baseline is enforced by a five-policy Conftest gate in GitHub Actions. Every apply on main is signed with Cosign and stored in the vault.",
        "purpose": "Accept patient intake submissions over HTTPS while keeping PHI/CUI under customer key custody, inside a controlled network boundary, with signed and immutable evidence that the controls stay in place.",
        "props": [
          {
            "name": "terraform-root-module",
